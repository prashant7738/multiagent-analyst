<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Insight Report — {{ dataset_name }}</title>
<script>(function(){try{var t=localStorage.getItem('ir-theme');if(t!=='dark'&&t!=='light'){t=(window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light';}document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
<script>document.documentElement.classList.add('js');</script>
<style>
  /* ── design tokens ──────────────────────────────────────────────────── */
  :root {
    --bg: #f5f7fb;
    --surface: #ffffff;
    --surface-2: #f8fafc;
    --border: #e5e7eb;
    --text: #1f2933;
    --muted: #6b7280;
    --accent: #2563eb;
    --accent-soft: #eff6ff;
    --good: #16a34a; --warn: #d97706; --bad: #dc2626;
    --shadow: 0 1px 3px rgba(16,24,40,.06), 0 4px 14px rgba(16,24,40,.04);
    --radius: 12px;
  }
  [data-theme="dark"] {
    --bg: #0b1220;
    --surface: #111827;
    --surface-2: #0f172a;
    --border: #26303e;
    --text: #e5e7eb;
    --muted: #94a3b8;
    --accent: #60a5fa;
    --accent-soft: #172554;
    --shadow: 0 1px 3px rgba(0,0,0,.4), 0 6px 18px rgba(0,0,0,.35);
  }

  /* ── base ───────────────────────────────────────────────────────────── */
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    color: var(--text); background: var(--bg);
    font-size: 11pt; line-height: 1.55; margin: 0;
  }
  h1 { font-size: 25pt; margin: 0 0 .1em; color: var(--text); letter-spacing: -.02em; }
  h2 { font-size: 15pt; margin: 1.8em 0 .5em; color: var(--text);
       border-bottom: 2px solid var(--border); padding-bottom: .3em; }
  h3 { font-size: 12pt; margin: 0 0 .35em; color: var(--text); }
  p { margin: .35em 0; }
  table { width: 100%; border-collapse: collapse; margin: .6em 0 1em; font-size: 9.5pt; }
  th, td { border: 1px solid var(--border); padding: 5px 9px; text-align: left; }
  th { background: var(--surface-2); color: var(--text); }
  tr:hover td { background: var(--surface-2); }
  ul { margin: .3em 0 1em; padding-left: 1.4em; }
  li { margin-bottom: .4em; }
  a { color: var(--accent); }
  abbr.glossary { text-decoration: underline dotted var(--accent); cursor: help; }
  .empty-note { color: var(--muted); font-style: italic; }
  .subtitle { color: var(--muted); font-size: 10pt; margin-top: 0; }

  /* ── progress bar ───────────────────────────────────────────────────── */
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 90; background: transparent; }
  .progress-bar { height: 100%; width: 0; background: linear-gradient(90deg, var(--accent), #7c3aed); transition: width .15s ease-out; }

  /* ── topbar ─────────────────────────────────────────────────────────── */
  .topbar {
    position: sticky; top: 0; z-index: 80;
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .topbar-inner { max-width: 1240px; margin: 0 auto; display: flex; align-items: center; gap: 18px; padding: 10px 20px; }
  .brand { font-weight: 800; font-size: 13pt; color: var(--text); text-decoration: none; letter-spacing: -.01em; white-space: nowrap; }
  .brand span { color: var(--accent); }
  .topnav { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; flex: 1; }
  .topnav::-webkit-scrollbar { display: none; }
  .topnav a {
    font-size: 9pt; color: var(--muted); text-decoration: none;
    padding: 6px 11px; border-radius: 999px; white-space: nowrap;
    border: 1px solid transparent;
  }
  .topnav a:hover { color: var(--text); background: var(--surface); }
  .topnav a.active { color: var(--accent); background: var(--accent-soft); border-color: color-mix(in srgb, var(--accent) 25%, transparent); }
  .topbar-actions { display: flex; gap: 8px; }
  .icon-btn {
    border: 1px solid var(--border); background: var(--surface); color: var(--text);
    width: 34px; height: 34px; border-radius: 9px; cursor: pointer; font-size: 14px;
    display: inline-flex; align-items: center; justify-content: center; transition: transform .15s ease;
  }
  .icon-btn:hover { transform: translateY(-1px); box-shadow: var(--shadow); }

  /* ── shell layout ───────────────────────────────────────────────────── */
  .layout { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 230px minmax(0,1fr); gap: 28px; padding: 22px 20px 60px; }
  .sidenav { position: sticky; top: 64px; align-self: start; max-height: calc(100vh - 84px); overflow-y: auto; padding: 6px 2px; }
  .sidenav-title { font-size: 8.5pt; text-transform: uppercase; letter-spacing: .09em; color: var(--muted); margin: 6px 0 10px; padding-left: 10px; }
  .sidenav a {
    display: flex; align-items: center; gap: 9px; position: relative;
    color: var(--muted); text-decoration: none; font-size: 9.5pt;
    padding: 6px 10px; border-radius: 8px; margin-bottom: 2px;
  }
  .sidenav a::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--border); flex: 0 0 auto; transition: background .2s; }
  .sidenav a:hover { color: var(--text); background: var(--surface); }
  .sidenav a.active { color: var(--text); background: var(--surface); box-shadow: var(--shadow); }
  .sidenav a.active::before { background: var(--accent); }
  .page { min-width: 0; }

  /* ── hero / badges / kpis ───────────────────────────────────────────── */
  .hero-chips { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 8px; }
  .chip {
    font-size: 8.5pt; background: var(--surface-2); border: 1px solid var(--border);
    color: var(--muted); border-radius: 999px; padding: 3px 11px;
  }
  .badge-row { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px; }
  .badge {
    display: inline-block; padding: 4px 12px; border-radius: 999px;
    font-size: 9.5pt; font-weight: 700; color: white;
  }
  .badge.good { background: var(--good); } .badge.warn { background: var(--warn); } .badge.bad { background: var(--bad); }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 20px 0 8px; }
  .kpi-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 14px 16px; box-shadow: var(--shadow); position: relative; overflow: hidden;
  }
  .kpi-card::after { content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; background: linear-gradient(90deg, var(--accent), transparent 70%); opacity: .55; }
  .kpi-label { font-size: 8.5pt; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); }
  .kpi-value { font-size: 17pt; font-weight: 800; line-height: 1.25; margin-top: 2px; }

  /* ── cards & boxes ──────────────────────────────────────────────────── */
  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 16px 20px; }
  .plain-language-box {
    background: linear-gradient(180deg, var(--accent-soft), var(--surface));
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
    border-radius: var(--radius); padding: 1em 1.3em; margin: 1.4em 0; page-break-inside: avoid;
  }
  .plain-language-box h2 { margin-top: .2em; border-bottom: none; padding-bottom: 0; }
  .bottom-line { font-size: 12.5pt; font-weight: 700; color: var(--accent); margin: 0 0 .8em; padding-bottom: .6em; border-bottom: 1px dashed color-mix(in srgb, var(--accent) 40%, transparent); }

  .story-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; margin: .8em 0 1.2em; }
  .story-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 13px 16px; box-shadow: var(--shadow); page-break-inside: avoid; }
  .story-card h3 { color: var(--accent); font-size: 9.5pt; text-transform: uppercase; letter-spacing: .06em; display: flex; align-items: center; gap: 7px; }
  .story-num { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-size: 9pt; }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: start; }
  @media (max-width: 860px) { .two-col { grid-template-columns: 1fr; } }

  /* ── chart sections ─────────────────────────────────────────────────── */
  .section-head { display: flex; align-items: baseline; gap: 12px; }
  .section-head h2 { margin-bottom: .2em; }
  .section-blurb { color: var(--muted); font-size: 10pt; margin-top: -0.2em; }
  .chart-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 15px 19px; margin: 0 0 18px; box-shadow: var(--shadow); page-break-inside: avoid;
  }
  .chart-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .chart-sub { color: var(--muted); font-size: 9.5pt; margin: .05em 0 .45em; }
  .chart-desc { font-size: 10pt; margin: .3em 0; }
  .llm-caption {
    font-size: 10pt; color: var(--accent); background: var(--accent-soft);
    border-left: 3px solid var(--accent); padding: 6px 11px; border-radius: 0 8px 8px 0; margin: .5em 0;
  }
  .chips { margin: .4em 0 .6em; display: flex; flex-wrap: wrap; gap: 6px; }
  .echart { width: 100%; height: 350px; }
  .chart-static { display: none; width: 100%; max-width: 700px; height: auto; margin: 4px auto; border-radius: 8px; }

  /* ── appendix ───────────────────────────────────────────────────────── */
  details.tech {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    padding: .1em 1.2em .7em; margin: 0 0 10px; page-break-inside: avoid;
  }
  details.tech > summary {
    cursor: pointer; font-weight: 700; color: var(--text); padding: .6em 0;
    font-size: 11.5pt; list-style-position: outside;
  }
  details[open].tech > summary { border-bottom: 1px solid var(--surface-2); margin-bottom: .3em; }
  details.tech h2 { border-bottom: none; margin-top: 1.1em; padding-bottom: 0; }
  details.tech h3 { margin-top: 1em; }
  .search-box {
    width: min(320px, 100%); margin: 2px 0 8px; padding: 7px 12px;
    border: 1px solid var(--border); border-radius: 999px; background: var(--surface-2);
    color: var(--text); font-size: 9.5pt; outline: none;
  }
  .search-box:focus { border-color: var(--accent); }
  .no-match-note { display: none; color: var(--muted); font-size: 9pt; font-style: italic; }

  /* ── glossary / footer / modal / misc ───────────────────────────────── */
  .glossary-grid { columns: 2; gap: 26px; }
  .glossary-grid > div { break-inside: avoid; margin-bottom: 10px; }
  @media (max-width: 760px) { .glossary-grid { columns: 1; } }
  .footer { margin-top: 2.4em; padding-top: .9em; border-top: 1px solid var(--border); font-size: 9pt; color: var(--muted); display: flex; flex-wrap: wrap; gap: 6px 18px; }

  .to-top {
    position: fixed; right: 22px; bottom: 22px; z-index: 70;
    width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--border);
    background: var(--surface); color: var(--text); cursor: pointer; font-size: 16px;
    box-shadow: var(--shadow); opacity: 0; pointer-events: none; transition: opacity .25s, transform .25s;
    transform: translateY(8px);
  }
  .to-top.show { opacity: 1; pointer-events: auto; transform: translateY(0); }

  .chart-modal { position: fixed; inset: 0; z-index: 120; display: flex; align-items: center; justify-content: center; }
  .chart-modal[hidden] { display: none; }
  .modal-backdrop { position: absolute; inset: 0; background: rgba(4, 10, 22, .62); }
  .modal-panel {
    position: relative; width: min(1100px, 94vw); height: min(86vh, 760px);
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
    box-shadow: 0 18px 60px rgba(0,0,0,.35); display: flex; flex-direction: column; overflow: hidden;
  }
  .modal-head { display: flex; align-items: center; justify-content: space-between; padding: 12px 18px; border-bottom: 1px solid var(--border); }
  .modal-head h3 { margin: 0; font-size: 12pt; }
  .modal-body { flex: 1; min-height: 0; padding: 10px; display: flex; }
  .modal-body .echart { height: 100%; }
  .modal-body img { max-width: 100%; max-height: 100%; margin: auto; object-fit: contain; }

  /* reveal-on-scroll — gated on html.js so content is NEVER hidden when the
     init script fails or JS is disabled. Progressive enhancement only. */
  .js [data-reveal] { opacity: 0; transform: translateY(14px); transition: opacity .5s ease, transform .5s ease; }
  .js [data-reveal].revealed { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    [data-reveal] { opacity: 1 !important; transform: none !important; transition: none !important; }
    .to-top { transition: none; }
  }

  /* responsive sidebar collapse */
  @media (max-width: 1020px) {
    .layout { grid-template-columns: 1fr; }
    .sidenav { display: none; }
  }

  /* ── cover / title page ─────────────────────────────────────────────── */
  .cover {
    min-height: 62vh; display: flex; flex-direction: column; justify-content: center;
    border-bottom: 3px solid var(--accent); padding: 3em 0 2.4em; margin-bottom: 1.5em;
  }
  .cover-kicker { font-size: 9.5pt; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); }
  .cover-title { font-size: 34pt; font-weight: 800; letter-spacing: -.02em; line-height: 1.12; margin: .25em 0 .1em; }
  .cover-dataset { font-size: 14.5pt; font-weight: 600; color: var(--accent); margin-top: .4em; overflow-wrap: anywhere; }
  .cover-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 1.2em; }
  .cover-stats { display: flex; flex-wrap: wrap; gap: 26px; margin-top: 1.6em; }
  .cover-stat .kpi-label { font-size: 8.5pt; }
  .cover-stat .kpi-value { font-size: 21pt; }
  .cover-foot { margin-top: auto; padding-top: 2em; font-size: 9pt; color: var(--muted); }

  /* ── table of contents ─────────────────────────────────────────────── */
  .toc ol { list-style: none; margin: .6em 0 0; padding: 0; max-width: 720px; }
  .toc li { margin: 0; border-bottom: 1px dotted var(--border); }
  .toc a { display: flex; align-items: baseline; gap: 8px; text-decoration: none; color: var(--text); padding: .32em 0; }
  .toc a:hover { color: var(--accent); }
  .toc .toc-num { color: var(--muted); font-size: 9pt; width: 1.6em; flex: 0 0 auto; }

  /* ── recommendation priority badges ────────────────────────────────── */
  .rec-row { display: flex; align-items: flex-start; gap: 10px; }
  .badge.pri-high { background: var(--good); }
  .badge.pri-medium { background: var(--warn); }
  .badge.pri-low { background: #6b7280; }
  .rec-pri { flex: 0 0 auto; margin-top: 2px; white-space: nowrap; }

  /* ── methodology & limitations ─────────────────────────────────────── */
  .method-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; margin-top: .8em; }
  .method-card { background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px 15px; page-break-inside: avoid; }
  .method-card h3 { font-size: 10pt; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .method-card ul { margin-bottom: 0; }
  .threshold-table td:first-child { font-weight: 600; }
  .lim-list li { margin-bottom: .5em; }
  .provenance-note { font-size: 9.5pt; color: var(--muted); margin-top: .8em; }

  /* ── print / PDF ────────────────────────────────────────────────────── */
  /* Page-number footers and TOC dot-leaders rely on CSS paged-media features
     (margin boxes + target-counter). WeasyPrint — which produces the PDF
     deliverable — honors them; browsers ignore @page margin boxes safely. */
  @page {
    size: A4;
    margin: 1.6cm 1.4cm;
    @bottom-center {
      content: "Page " counter(page) " of " counter(pages);
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 8pt;
      color: #6b7280;
    }
  }
  @page :first { @bottom-center { content: none; } }
  @media print {
    :root { --bg:#ffffff; --surface:#ffffff; --surface-2:#f3f4f6; --border:#d1d5db;
            --text:#111827; --muted:#4b5563; --accent:#1e3a8a; --accent-soft:#eff6ff; --shadow:none; }
    html { scroll-behavior: auto; }
    .progress, .topbar-actions, .to-top, .search-box, .expand-btn, .chart-modal { display: none !important; }
    .topbar { position: static; backdrop-filter: none; background: none; border-bottom: 1px solid var(--border); }
    .topnav { display: none; }
    .layout { display: block; max-width: none; padding: 0; }
    .echart { display: none !important; }
    .chart-static { display: block !important; margin: 4px auto; }
    .kpi-card, .panel, .chart-card, details.tech { box-shadow: none; }
    .section-blurb, .footer { color: var(--muted); }
    /* The cover opens the printed document; everything else starts on a fresh page. */
    .cover { min-height: 78vh; page-break-after: always; border-bottom: none; }
    .toc { page-break-after: always; }
    .toc a::after {
      content: leader(".") " " target-counter(attr(href), page);
      color: var(--muted);
      margin-left: auto;
      padding-left: 8px;
    }
    .toc a { display: flex; }
    .section-head, h2 { page-break-after: avoid; }
    .panel, .two-col { page-break-inside: avoid; }
  }
</style>
</head>
<body>
<noscript>
<style>
  .echart { display: none !important; }
  .chart-static { display: block !important; }
  .needs-js { display: none !important; }
  [data-reveal] { opacity: 1 !important; transform: none !important; }
</style>
</style>
</noscript>

<div class="progress needs-js" aria-hidden="true"><div class="progress-bar" id="progressBar"></div></div>

<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="#overview">Insight<span>Report</span></a>
    <nav class="topnav" aria-label="Sections">
      <a href="#overview" data-target="overview">Overview</a>
      <a href="#plain-english" data-target="plain-english">Plain English</a>
      {% if story and story.get('what_happened') %}<a href="#the-story" data-target="the-story">The Story</a>{% endif %}
      <a href="#findings" data-target="findings">Findings</a>
      {% for key, sec in chart_sections %}
      <a href="#sec-{{ key }}" data-target="sec-{{ key }}">{{ sec.heading }}</a>
      {% endfor %}
      <a href="#recommendations" data-target="recommendations">Recommendations</a>
      <a href="#appendix" data-target="appendix">Appendix</a>
      <a href="#glossary" data-target="glossary">Glossary</a>
    </nav>
    <div class="topbar-actions">
      <button id="themeToggle" class="icon-btn needs-js" type="button" title="Toggle dark mode" aria-label="Toggle dark mode">◐</button>
      <button class="icon-btn" type="button" onclick="window.print()" title="Print / Save as PDF" aria-label="Print report">⎙</button>
    </div>
  </div>
</header>

<div class="layout">

<aside class="sidenav needs-js" aria-label="On this page">
  <div class="sidenav-title">Contents</div>
  <a href="#overview" data-target="overview">Overview</a>
  <a href="#plain-english" data-target="plain-english">In Plain English</a>
  {% if story and story.get('what_happened') %}<a href="#the-story" data-target="the-story">The Story</a>{% endif %}
  <a href="#findings" data-target="findings">Key Findings</a>
  {% for key, sec in chart_sections %}
  <a href="#sec-{{ key }}" data-target="sec-{{ key }}">{{ sec.heading }}</a>
  {% endfor %}
  <a href="#recommendations" data-target="recommendations">Recommendations</a>
  <a href="#appendix" data-target="appendix">Technical Appendix</a>
  <a href="#glossary" data-target="glossary">Glossary</a>
</aside>

<main class="page">

<section class="cover" id="cover">
  <p class="cover-kicker">Automated analysis &middot; Agents 1&ndash;6 pipeline</p>
  <h1 class="cover-title">Data Insight Report</h1>
  <p class="cover-dataset">{{ dataset_name }}</p>
  {% set cover_quality = facts.data_quality.overall_quality_score %}
  <div class="badge-row">
    <span class="chip">Generated {{ generated_at }}</span>
    {% if cover_quality is not none %}
      {% if cover_quality >= 80 %}<span class="badge good">Quality {{ cover_quality }}/100</span>
      {% elif cover_quality >= 50 %}<span class="badge warn">Quality {{ cover_quality }}/100</span>
      {% else %}<span class="badge bad">Quality {{ cover_quality }}/100</span>{% endif %}
    {% endif %}
    {% if facts.validation.passed %}
      <span class="badge good">Validation passed</span>
    {% else %}
      <span class="badge bad">Validation issues</span>
    {% endif %}
  </div>
  <div class="cover-stats">
    {% for card in kpis[:4] %}
    <div class="cover-stat">
      <div class="kpi-label">{{ card.label }}</div>
      <div class="kpi-value">{{ card.value }}</div>
    </div>
    {% endfor %}
  </div>
  <p class="cover-foot">
    Prepared automatically from the uploaded dataset. Every figure is computed by the
    deterministic pipeline and cross-checked against it; see Methodology &amp; Provenance
    for how this report was produced.
  </p>
</section>

<nav class="toc" id="contents" aria-label="Table of contents">
  <h2 style="border-bottom:none;">Contents</h2>
  <ol>
    <li><a href="#overview"><span class="toc-num">{{ 1 }}.</span> Overview</a></li>
    {% if narrative.plain_language_insights or narrative.bottom_line %}
    <li><a href="#plain-english"><span class="toc-num">{{ 2 }}.</span> In Plain English</a></li>
    {% endif %}
    {% if story and story.get('what_happened') %}
    <li><a href="#the-story"><span class="toc-num">{{ 3 }}.</span> The Story</a></li>
    {% endif %}
    <li><a href="#findings"><span class="toc-num">{{ 4 }}.</span> Executive Summary &amp; Key Findings</a></li>
    {% if limitations %}
    <li><a href="#limitations"><span class="toc-num">{{ 5 }}.</span> Assumptions &amp; Limitations</a></li>
    {% endif %}
    {% for key, sec in chart_sections %}
    <li><a href="#sec-{{ key }}"><span class="toc-num">&sect;</span> {{ sec.heading }}</a></li>
    {% endfor %}
    {% if narrative.recommendations %}
    <li><a href="#recommendations"><span class="toc-num">&sect;</span> Recommendations</a></li>
    {% endif %}
    {% if methodology %}
    <li><a href="#methodology"><span class="toc-num">&sect;</span> Methodology &amp; Data Provenance</a></li>
    {% endif %}
    <li><a href="#appendix"><span class="toc-num">&sect;</span> Technical Appendix</a></li>
    <li><a href="#glossary"><span class="toc-num">&sect;</span> Glossary</a></li>
  </ol>
</nav>

<section id="overview">
  <h1>Data Insight Report</h1>
  <p class="subtitle">{{ dataset_name }} &middot; generated {{ generated_at }}</p>

  {% set quality = facts.data_quality.overall_quality_score %}
  <div class="badge-row">
    {% if quality is not none and quality >= 80 %}
      <span class="badge good">Data Quality: {{ quality }}/100</span>
    {% elif quality is not none and quality >= 50 %}
      <span class="badge warn">Data Quality: {{ quality }}/100</span>
    {% elif quality is not none %}
      <span class="badge bad">Data Quality: {{ quality }}/100</span>
    {% endif %}
    {% if facts.validation.passed %}
      <span class="badge good">Validation Passed · {{ facts.validation.overall_validation_score }}/100</span>
    {% else %}
      <span class="badge bad">Validation Failed</span>
    {% endif %}
  </div>

  {% if kpis %}
  <div class="kpis" data-reveal>
    {% for card in kpis %}
    <div class="kpi-card">
      <div class="kpi-label">{{ card.label }}</div>
      <div class="kpi-value">{{ card.value }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if facts.data_quality.overall_quality_score_pre_anomaly is not none and (facts.data_quality.anomaly_quality_penalty or facts.data_quality.data_quality_issue_penalty) %}
  <p class="empty-note">
    Data health adjusted from a pre-analysis score of {{ facts.data_quality.overall_quality_score_pre_anomaly }}:
    &minus;{{ facts.data_quality.data_quality_issue_penalty or 0 }} points for structural data issues
    ({{ facts.data_quality.data_quality_issue_row_pct or 0 }}% of rows) and
    &minus;{{ facts.data_quality.anomaly_quality_penalty or 0 }} points for unusual records
    ({{ facts.data_quality.statistical_outlier_row_pct or 0 }}% of rows).
  </p>
  {% endif %}
</section>

{% if narrative.plain_language_insights or narrative.bottom_line %}
<div class="plain-language-box" id="plain-english" data-reveal>
  <h2>In Plain English</h2>
  <p class="subtitle" style="margin-bottom:.6em;">No statistics background needed — here's what this data actually means for you.</p>
  {% if narrative.bottom_line %}
  <p class="bottom-line">{{ narrative.bottom_line | abbr_glossary(glossary) }}</p>
  {% endif %}
  {% if narrative.plain_language_insights %}
  <ul>
    {% for insight in narrative.plain_language_insights %}
    <li>{{ insight | abbr_glossary(glossary) }}</li>
    {% endfor %}
  </ul>
  {% endif %}
</div>
{% endif %}

{% if story and story.get('what_happened') %}
<section id="the-story" data-reveal>
  <h2>The Story</h2>
  <div class="story-grid">
    <div class="story-card">
      <h3><span class="story-num">1</span> What happened</h3>
      <p>{{ story.get('what_happened', '') | abbr_glossary(glossary) }}</p>
    </div>
    <div class="story-card">
      <h3><span class="story-num">2</span> Why it matters</h3>
      <p>{{ story.get('why_it_matters', '') | abbr_glossary(glossary) }}</p>
    </div>
    <div class="story-card">
      <h3><span class="story-num">3</span> What to do next</h3>
      <p>{{ story.get('what_to_do_next', '') | abbr_glossary(glossary) }}</p>
    </div>
  </div>
</section>
{% endif %}

<section id="findings" data-reveal>
  <h2>Executive Summary</h2>
  <p>{{ narrative.executive_summary }}</p>
  <h3 style="margin-top:1em;">Key Findings</h3>
  {% if narrative.key_findings %}
  <ul>
    {% for finding in narrative.key_findings %}
    <li>{{ finding | abbr_glossary(glossary) }}</li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="empty-note">No key findings available.</p>
  {% endif %}
</section>

{% for key, sec in chart_sections %}
<section id="sec-{{ key }}" data-reveal>
  <div class="section-head"><h2>{{ sec.heading }}</h2></div>
  {% if sec.blurb %}<p class="section-blurb">{{ sec.blurb }}</p>{% endif %}
  {% for c in sec.charts %}
  <div class="chart-card" id="chart-{{ c.id }}" data-reveal>
    <div class="chart-head">
      <div>
        <h3>{{ c.title }}</h3>
        {% if c.subtitle %}<p class="chart-sub">{{ c.subtitle }}</p>{% endif %}
      </div>
      {% if c.img_b64 %}
      <button class="icon-btn expand-btn needs-js" type="button" data-expand="{{ c.id }}" data-title="{{ c.title }}" title="View full size" aria-label="View chart full size">⤢</button>
      {% endif %}
    </div>
    {% set desc = c.plain_summary or c.why_it_matters %}
    {% if desc %}<p class="chart-desc">{{ desc | abbr_glossary(glossary) }}</p>{% endif %}
    {% if c.llm_caption %}<p class="llm-caption">{{ c.llm_caption | abbr_glossary(glossary) }}</p>{% endif %}
    {% if c.annotations %}
    <div class="chips">
      {% for a in c.annotations %}{% if a.label %}
      <span class="chip">{{ a.label }}{% if a.value is defined and a.value is not none and a.value != '' %}:&nbsp;<strong>{% if a.value is number %}{{ a.value | humnum }}{% else %}{{ a.value }}{% endif %}</strong>{% endif %}</span>
      {% endif %}{% endfor %}
    </div>
    {% endif %}
    {% if c.render == 'echarts' and c.option_json and has_interactive and c.img_b64 %}
    <div class="echart" id="ec-{{ c.id }}" data-option="{{ c.option_json }}"></div>
    <img class="chart-static" src="{{ c.img_b64 }}" alt="{{ c.alt_text }}">
    {% elif c.img_b64 %}
    <img src="{{ c.img_b64 }}" alt="{{ c.alt_text }}" style="{% if has_interactive %}width:100%; max-width:700px; display:block; margin:4px auto; border-radius:8px;{% endif %}">
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endfor %}

{% if narrative.risks_and_caveats or narrative.recommendations %}
<div class="two-col">
  {% if narrative.risks_and_caveats %}
  <div class="panel" data-reveal>
    <h3>Risks &amp; Caveats</h3>
    <ul>
      {% for risk in narrative.risks_and_caveats %}
      <li>{{ risk }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
  {% if narrative.recommendations %}
  <div class="panel" id="recommendations" data-reveal>
    <h3>Recommendations</h3>
    <ul>
      {% for rec in narrative.recommendations %}
      <li>{{ rec | abbr_glossary(glossary) }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
</div>
{% endif %}

<div id="appendix" data-reveal>
<h2>Technical Appendix</h2>
<p class="empty-note">Detailed workings behind the summary above — open a section when you need the underlying tables.</p>

{% macro filter_box() %}
<input class="search-box needs-js" type="search" placeholder="Filter rows…" aria-label="Filter table rows">
<span class="no-match-note">No matching rows.</span>
{% endmacro %}

{% if facts.data_quality.derived_metric_reconciliation %}
<details class="tech">
  <summary>⚠ Derived Metric Divergence</summary>
  <p class="empty-note">
    The source data already contains a column matching one of the pipeline's derived business metrics, but
    the two disagree beyond tolerance (r &lt; 0.99 or mean absolute % difference &gt; 1%). This means the
    derivation formula or its source-column resolution is likely wrong for this dataset - treat the
    affected derived metric as unreliable until reviewed.
  </p>
  <table>
    <tr><th>Derived Column</th><th>Matched Source Column</th><th>Correlation (r)</th><th>MAPE %</th><th>Rows Compared</th></tr>
    {% for item in facts.data_quality.derived_metric_reconciliation %}
    <tr>
      <td>{{ item.derived_column }}</td><td>{{ item.matched_source_column }}</td>
      <td>{{ item.correlation }}</td><td>{{ item.mape_pct }}</td><td>{{ item.n }}</td>
    </tr>
    {% endfor %}
  </table>
</details>
{% endif %}
{% if facts.data_quality_detail %}
<details class="tech" open>
  <summary>Data quality detail</summary>
{% set dqd = facts.data_quality_detail %}
{{ filter_box() }}
<h2>Data Quality Detail</h2>
<h3>Duplicate Handling</h3>
<ul>
  <li>Duplicates detected: {{ dqd.duplicates.exact_duplicates_detected }}</li>
  {% if dqd.duplicates.near_duplicates_detected %}
  <li>Near-duplicates detected: {{ dqd.duplicates.near_duplicates_detected }}</li>
  {% endif %}
  <li>Action: {{ dqd.duplicates.action }}</li>
  {% if dqd.duplicates.near_duplicates_detected %}
  <li>Near-duplicate action: {{ dqd.duplicates.near_duplicate_action }}</li>
  {% endif %}
</ul>
<h3>Missing Values</h3>
{% if dqd.has_missing %}
<table>
  <tr><th>Column</th><th>Missing Count</th><th>Missing %</th><th>Action</th></tr>
  {% for row in dqd.missing_values %}
  <tr>
    <td>{{ row.column }}</td><td>{{ row.missing_count }}</td>
    <td>{{ row.missing_pct }}%</td><td>{{ row.action }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p class="empty-note">No missing values detected in the source dataset.</p>
{% endif %}
</details>
{% endif %}

{% if facts.top_correlations %}
<details class="tech">
  <summary>Correlations between columns</summary>
{{ filter_box() }}
<h2>Top Correlations</h2>
<p class="empty-note">Computed on the cleaned dataset (after outlier clipping, imputation, and scaling) — values may differ from a Pearson correlation run directly on the raw file.</p>
<table>
  <tr><th>Column 1</th><th>Column 2</th><th>Pearson r</th><th>Strength</th><th>Direction</th></tr>
  {% for pair in facts.top_correlations %}
  <tr>
    <td>{{ pair.col1 }}</td><td>{{ pair.col2 }}</td>
    <td>{{ pair.pearson_r }}</td><td>{{ pair.strength }}</td><td>{{ pair.direction }}</td>
  </tr>
  {% endfor %}
</table>
</details>
{% endif %}

{% if facts.excluded_columns and (facts.excluded_columns.flagged_columns or facts.excluded_columns.excluded_pairs) %}
<details class="tech">
  <summary>Excluded columns (IDs / artifacts)</summary>
{{ filter_box() }}
<h2>Excluded — Likely IDs or Artifacts</h2>
<p class="empty-note">These columns look like identifiers or external-model outputs rather than business signals, so they are excluded from the headline findings above.</p>
{% if facts.excluded_columns.flagged_columns %}
<p><strong>Flagged columns:</strong> {{ facts.excluded_columns.flagged_columns | join(", ") }}</p>
{% endif %}
{% if facts.excluded_columns.excluded_pairs %}
<table>
  <tr><th>Column 1</th><th>Column 2</th><th>Pearson r</th><th>Strength</th><th>Direction</th></tr>
  {% for pair in facts.excluded_columns.excluded_pairs %}
  <tr>
    <td>{{ pair.col1 }}</td><td>{{ pair.col2 }}</td>
    <td>{{ pair.pearson_r }}</td><td>{{ pair.strength }}</td><td>{{ pair.direction }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}
</details>
{% endif %}

{% if facts.formulaic_pairs %}
<details class="tech">
  <summary>Known formula relationships</summary>
{{ filter_box() }}
<h2>Excluded — Known Formula Relationships</h2>
<p class="empty-note">One column in each pair is a direct formula of the other (e.g. profit = revenue &minus; cost) — tautological, not an insight.</p>
<table>
  <tr><th>Column 1</th><th>Column 2</th><th>Pearson r</th><th>Strength</th><th>Direction</th></tr>
  {% for pair in facts.formulaic_pairs %}
  <tr>
    <td>{{ pair.col1 }}</td><td>{{ pair.col2 }}</td>
    <td>{{ pair.pearson_r }}</td><td>{{ pair.strength }}</td><td>{{ pair.direction }}</td>
  </tr>
  {% endfor %}
</table>
</details>
{% endif %}

{% if facts.significant_trends %}
<details class="tech">
  <summary>Trend statistics per column</summary>
{{ filter_box() }}
<h2>Significant Trends</h2>
<table>
  <tr><th>Column</th><th>Trend</th><th>r²</th><th>p-value</th></tr>
  {% for trend in facts.significant_trends %}
  <tr>
    <td>{{ trend.column }}</td><td>{{ trend.trend }}</td>
    <td>{{ trend.r_squared }}</td><td>{{ trend.p_value }}</td>
  </tr>
  {% endfor %}
</table>
</details>
{% endif %}

{% if facts.rankings %}
<details class="tech">
  <summary>Top / bottom rankings</summary>
{{ filter_box() }}
<h2>Top / Bottom Rankings</h2>
{% for cat_col, data in facts.rankings.items() %}
<h3>{{ cat_col }} (showing {{ data.top | length + data.bottom | length }} of {{ data.total_categories }} categories)</h3>
<table>
  <tr><th>Rank</th><th>{{ cat_col }}</th><th>Total {{ data.metric_label or "Revenue" }}</th><th>Share %</th></tr>
  {% for row in data.top %}
  <tr><td>Top</td><td>{{ row[cat_col] }}</td><td>{{ row.total_revenue }}</td><td>{{ row.revenue_share_pct }}</td></tr>
  {% endfor %}
  {% for row in data.bottom %}
  <tr><td>Bottom</td><td>{{ row[cat_col] }}</td><td>{{ row.total_revenue }}</td><td>{{ row.revenue_share_pct }}</td></tr>
  {% endfor %}
</table>
{% endfor %}
</details>
{% endif %}

{% if facts.profit_breakdown %}
<details class="tech">
  <summary>Profit breakdown</summary>
{{ filter_box() }}
<h2>Profit Breakdown</h2>
{% for cat_col, data in facts.profit_breakdown.items() %}
<h3>{{ cat_col }} (showing {{ data.top | length + data.bottom | length }} of {{ data.total_categories }} categories)</h3>
<table>
  <tr><th>Rank</th><th>{{ cat_col }}</th><th>Total Profit</th><th>Share %</th></tr>
  {% for row in data.top %}
  <tr><td>Top</td><td>{{ row[cat_col] }}</td><td>{{ row.total_profit }}</td><td>{{ row.profit_share_pct }}</td></tr>
  {% endfor %}
  {% for row in data.bottom %}
  <tr><td>Bottom</td><td>{{ row[cat_col] }}</td><td>{{ row.total_profit }}</td><td>{{ row.profit_share_pct }}</td></tr>
  {% endfor %}
</table>
{% endfor %}
</details>
{% endif %}

{% set xdim = facts.cross_dimensional %}
{% set lead_time = xdim.get('shipping_lead_time', {}) if xdim else {} %}
{% if xdim and (xdim.discount_return_rate.buckets or xdim.rep_discount_margin.records or xdim.segment_order_value.records or xdim.region_shipping_cost.records or xdim.category_margin_trend or lead_time.get('distribution')) %}
<details class="tech">
  <summary>Cross-dimensional analysis</summary>
{{ filter_box() }}
<h2>Cross-Dimensional Analysis</h2>

{% if xdim.discount_return_rate.buckets %}
<h3>Return Rate by Discount Quartile</h3>
<table>
  <tr><th>Discount Range</th><th>Return Rate %</th><th>Records</th></tr>
  {% for bucket in xdim.discount_return_rate.buckets %}
  <tr><td>{{ bucket.discount_range }}</td><td>{{ bucket.return_rate_pct }}</td><td>{{ bucket.records }}</td></tr>
  {% endfor %}
</table>
{% endif %}

{% if xdim.rep_discount_margin.records %}
<h3>Avg Discount % and Margin by {{ xdim.rep_discount_margin.rep_column }}</h3>
<table>
  <tr><th>{{ xdim.rep_discount_margin.rep_column }}</th><th>Avg Discount %</th><th>Avg Margin %</th></tr>
  {% for r in xdim.rep_discount_margin.records[:10] %}
  <tr><td>{{ r[xdim.rep_discount_margin.rep_column] }}</td><td>{{ r.avg_discount_pct }}</td><td>{{ r.avg_margin_pct }}</td></tr>
  {% endfor %}
</table>
{% endif %}

{% if xdim.segment_order_value.records %}
<h3>Avg Order Value by {{ xdim.segment_order_value.segment_column }}</h3>
<table>
  <tr><th>{{ xdim.segment_order_value.segment_column }}</th><th>Avg Order Value</th></tr>
  {% for r in xdim.segment_order_value.records %}
  <tr><td>{{ r[xdim.segment_order_value.segment_column] }}</td><td>{{ r.avg_order_value }}</td></tr>
  {% endfor %}
</table>
{% endif %}

{% if xdim.region_shipping_cost.records %}
<h3>Avg Shipping Cost by {{ xdim.region_shipping_cost.region_column }}</h3>
<table>
  <tr><th>{{ xdim.region_shipping_cost.region_column }}</th><th>Avg Shipping Cost</th></tr>
  {% for r in xdim.region_shipping_cost.records %}
  <tr><td>{{ r[xdim.region_shipping_cost.region_column] }}</td><td>{{ r.avg_shipping_cost }}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% if lead_time.get('distribution') %}
<h3>Shipping Lead Time</h3>
<p>Orders took {{ lead_time.distribution.mean_days }} days on average to ship, with a median of {{ lead_time.distribution.median_days }} days and a range of {{ lead_time.distribution.min_days }} to {{ lead_time.distribution.max_days }} days.</p>
{% for dimension, data in lead_time.get('by_dimension', {}).items() %}
<h4>Lead Time by {{ dimension }}</h4>
<table>
  <tr><th>{{ dimension }}</th><th>Mean Days</th><th>Median Days</th><th>Orders</th></tr>
  {% for row in data.top %}
  <tr><td>{{ row[dimension] }}</td><td>{{ row.mean_days }}</td><td>{{ row.median_days }}</td><td>{{ row.orders }}</td></tr>
  {% endfor %}
</table>
{% endfor %}
{% endif %}

{% if xdim.category_margin_trend %}
<p class="empty-note">Profit margin by product category over time is shown in the Direction of travel section above.</p>
{% endif %}
</details>
{% endif %}

{% if facts.category_normalization %}
<details class="tech">
  <summary>Category normalization audit</summary>
{{ filter_box() }}
<h2>Normalization Applied</h2>
<p class="empty-note">Only low-impact category spelling variants were merged after case/separator folding.</p>
<table>
  <tr><th>Column</th><th>Raw Value</th><th>Canonical Value</th><th>Row Count</th></tr>
  {% for row in facts.category_normalization %}
  <tr><td>{{ row.column }}</td><td>{{ row.raw }}</td><td>{{ row.canonical }}</td><td>{{ row.row_count }}</td></tr>
  {% endfor %}
</table>
</details>
{% endif %}

{% if (facts.anomalies and facts.anomalies.unique_flagged_rows) or (facts.anomalies and facts.anomalies.data_quality_issue_rows) %}
<details class="tech">
  <summary>Anomalies &amp; data-quality issues</summary>
{{ filter_box() }}
<h2>Anomalies &amp; Data-Quality Issues</h2>
{% if facts.anomalies.unique_flagged_rows %}
<h3>Statistical Outliers</h3>
<p>
  {{ facts.anomalies.statistical_outlier_rows }} rows ({{ facts.anomalies.statistical_outlier_row_pct }}%) flagged as statistical outliers across
  {{ facts.anomalies.flagged_columns }} column(s). These are extreme distributional values, not automatically data-quality errors.
  Each column uses a z-score threshold of
  {{ facts.anomalies.z_threshold }} on its raw or log-transformed values (log-transformed for
  right-skewed columns) or a wider IQR rule for skewed columns with non-positive values, so the
  method adapts to each column's distribution instead of assuming normality everywhere.
</p>
{% endif %}
{% if facts.anomalies.prioritized_anomalies %}
<h3>Business Impact of Unusual Entries</h3>
<table>
  <tr><th>Column</th><th>Flagged Values</th><th>Estimated Business Impact</th></tr>
  {% for item in facts.anomalies.prioritized_anomalies %}
  <tr><td>{{ item.column }}</td><td>{{ item.flagged_count }}</td><td>{{ item.business_impact }}</td></tr>
  {% endfor %}
</table>
{% endif %}
<h3>Structural Data-Quality Issues</h3>
{% if facts.anomalies.data_quality_issue_rows %}
<p>
  {{ facts.anomalies.data_quality_issue_rows }} rows ({{ facts.anomalies.data_quality_issue_row_pct }}%)
  violate the structural checks performed on this dataset{% if facts.anomalies.rules_checked %}: {{ facts.anomalies.rules_checked | join(', ') }}{% endif %}.
  Unlike statistical outliers, these are genuine defects and drive the Data Quality Score penalty.
</p>
{% if facts.anomalies.issues_by_rule %}
<table>
  <tr><th>Rule</th><th>Rows Flagged</th><th>Review</th></tr>
  {% for rule, count in facts.anomalies.issues_by_rule.items() %}
  {% set detail = facts.anomalies.rule_details.get(rule, {}) %}
  <tr><td>{{ rule }}</td><td>{{ count }}</td><td>{% if detail.review_required %}Human review required{% else %}Automatic check{% endif %}</td></tr>
  {% if detail.review_required and detail.example_rows %}
  <tr><td colspan="3"><strong>Example rows:</strong> {{ detail.example_rows | tojson }}</td></tr>
  {% endif %}
  {% endfor %}
</table>
{% endif %}
{% else %}
<p class="empty-note">No structural data-quality violations detected.</p>
{% endif %}
</details>
{% endif %}
</div>

{% set grounding = narrative.claims_grounding %}
{% if grounding and grounding.claims_checked %}
<section data-reveal>
<h2>Internal Consistency Check</h2>
<p>
  Internal consistency: {{ grounding.claims_grounded }} of {{ grounding.claims_checked }} narrative
  figures match pipeline output (confidence {{ grounding.confidence }}).
  {% if grounding.claims_flagged %}
    {{ grounding.claims_flagged }} figure(s) could not be matched and should be double-checked.
    <ul>
      {% for claim in grounding.flagged_examples %}
      <li>{{ claim.source }}: {{ claim.value }} could not be matched to the deterministic pipeline facts.</li>
      {% endfor %}
    </ul>
  {% endif %}
  This only checks the narrative against the pipeline&rsquo;s own intermediate values &mdash; it does
  not verify those values against the original source data.
</p>
{% set recon = facts.validation.ground_truth_reconciliation %}
<p>
  <strong>Ground-truth reconciliation (separate check):</strong>
  {% if recon %}
    pipeline output vs. the source dataset &mdash;
    {{ "PASS" if recon.status == "pass" else ("WARN" if recon.status == "warn" else "FAIL") }}
    ({{ recon.detail }}).
  {% else %}
    verified independently by the Phase&nbsp;1 reconciliation test harness
    (tests/test_ground_truth_reconciliation.py), which checks the pipeline&rsquo;s numbers against
    the raw source CSV.
  {% endif %}
</p>
</section>
{% endif %}

{% if glossary %}
<section id="glossary" data-reveal>
<h2>Glossary</h2>
<p class="empty-note">Hover any dotted-underlined term in this report to see its explanation.</p>
<div class="glossary-grid">
  {% for term, explanation in glossary.items() %}
  <div><strong>{{ term }}</strong><br><span style="color:var(--muted); font-size:10pt;">{{ explanation }}</span></div>
  {% endfor %}
</div>
</section>
{% endif %}

<div class="footer">
  <span>Validation score: {{ facts.validation.overall_validation_score }}/100</span>
  <span>Cohen&rsquo;s kappa: {{ facts.validation.cohen_kappa }}</span>
  <span>Pipeline confidence: {{ facts.reliability.overall_confidence }} ({{ facts.reliability.decision_readiness }})</span>
  <span>Narrative source: {{ narrative.source }}</span>
</div>

</main>
</div>

<button class="to-top needs-js" id="toTop" type="button" title="Back to top" aria-label="Back to top">↑</button>

<div class="chart-modal" id="chartModal" hidden role="dialog" aria-modal="true" aria-label="Chart full view">
  <div class="modal-backdrop" data-close-modal></div>
  <div class="modal-panel">
    <div class="modal-head">
      <h3 id="modalTitle">Chart</h3>
      <button class="icon-btn" type="button" data-close-modal title="Close" aria-label="Close full view">✕</button>
    </div>
    <div class="modal-body" id="modalBody"></div>
  </div>
</div>

{% if has_interactive %}
{% autoescape false %}<script>{{ echarts_lib }}</script>{% endautoescape %}
<script>
(function () {
  function humanize(value) {
    if (value === null || value === undefined || isNaN(Number(value))) return String(value === undefined ? '' : value);
    var n = Number(value), sign = n < 0 ? '-' : '', a = Math.abs(n);
    function trim(s) { return s.replace(/\.?0+$/, ''); }
    if (a >= 1e9) return sign + trim((a / 1e9).toFixed(2)) + 'B';
    if (a >= 1e6) return sign + trim((a / 1e6).toFixed(2)) + 'M';
    if (a >= 1e3) return sign + trim((a / 1e3).toFixed(2)) + 'K';
    if (a % 1 === 0 && a < 1e3) return sign + String(a);
    return sign + String(+a.toFixed(2));
  }
  function makeFormatter(fmt, symbol) {
    return function (value) {
      if (value === null || value === undefined || isNaN(Number(value))) return '';
      var body = humanize(value);
      if (fmt === 'percent') return body + '%';
      if (fmt === 'currency') return symbol + body;
      return body;
    };
  }

  /* One broken widget must never take down the page: every init block below
     runs inside safe(), so a missing element or throwing library degrades
     that widget only — sections stay visible and static images stay usable. */
  function safe(block) {
    try { block(); } catch (err) { if (window.console) console.warn('report init:', err); }
  }

  var instances = [];
  document.querySelectorAll('.echart').forEach(function (el) {
    try {
      var rawOption = el.getAttribute('data-option');
      if (!rawOption) return;
      var option = JSON.parse(rawOption);
      var fmt = option.__fmt || 'number', symbol = option.__symbol || '';
      delete option.__fmt; delete option.__symbol;
      var vf = makeFormatter(fmt, symbol);
      ['xAxis', 'yAxis'].forEach(function (axisName) {
        var axes = option[axisName];
        if (!axes) return;
        if (!Array.isArray(axes)) axes = [axes];
        axes.forEach(function (ax) {
          if (ax && ax.type === 'value') ax.axisLabel = Object.assign({}, ax.axisLabel, { formatter: vf });
        });
      });
      if (option.tooltip) option.tooltip.valueFormatter = vf;
      var chart = echarts.init(el, null, { renderer: 'canvas' });
      chart.setOption(option);
      el.__chartInstance = chart;
      instances.push(chart);
    } catch (err) {
      el.style.display = 'none';
      var img = el.parentElement.querySelector('.chart-static');
      if (img) img.style.display = 'block';
    }
  });

  // ── theme toggle ────────────────────────────────────────────────────────
  safe(function () {
    var themeBtn = document.getElementById('themeToggle');
    if (!themeBtn) return;
    function syncThemeIcon() {
      var dark = document.documentElement.getAttribute('data-theme') === 'dark';
      themeBtn.textContent = dark ? '☾' : '☀';
    }
    themeBtn.addEventListener('click', function () {
      var dark = document.documentElement.getAttribute('data-theme') === 'dark';
      var next = dark ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('ir-theme', next); } catch (e) {}
      syncThemeIcon();
    });
    syncThemeIcon();
  });

  // ── reading progress + back-to-top ─────────────────────────────────────
  safe(function () {
    var bar = document.getElementById('progressBar');
    var toTop = document.getElementById('toTop');
    if (!bar || !toTop) return;
    function onScroll() {
      var doc = document.documentElement;
      var max = doc.scrollHeight - window.innerHeight;
      bar.style.width = (max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0) + '%';
      toTop.classList.toggle('show', window.scrollY > 600);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    toTop.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
  });

  // ── scrollspy (topnav + sidenav) ───────────────────────────────────────
  safe(function () {
    var links = Array.prototype.slice.call(document.querySelectorAll('[data-target]'));
    var targets = links.map(function (l) { return document.getElementById(l.getAttribute('data-target')); })
                       .filter(Boolean);
    if ('IntersectionObserver' in window && targets.length) {
      var spy = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          var id = entry.target.id;
          links.forEach(function (l) { l.classList.toggle('active', l.getAttribute('data-target') === id); });
        });
      }, { rootMargin: '-70px 0px -66% 0px', threshold: 0 });
      targets.forEach(function (t) { spy.observe(t); });
    }
  });

  // ── reveal on scroll ───────────────────────────────────────────────────
  /* Content visibility must never depend on this succeeding: a fallback
     timer force-reveals anything the observer missed (or that never ran). */
  safe(function () {
    var revealEls = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]:not(.revealed)'));
    function revealAll() { revealEls.forEach(function (el) { el.classList.add('revealed'); }); }
    if ('IntersectionObserver' in window) {
      try {
        var revealer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) { entry.target.classList.add('revealed'); revealer.unobserve(entry.target); }
          });
        }, { threshold: 0.08 });
        revealEls.forEach(function (el) { revealer.observe(el); });
        setTimeout(revealAll, 4000); // absolute backstop — nothing stays hidden
      } catch (e) { revealAll(); }
    } else {
      revealAll();
    }
  });

  // ── animated KPI counters (pure-number values only) ────────────────────
  safe(function () {
    var reduceMotion = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion && 'IntersectionObserver' in window) {
    var counterObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        counterObs.unobserve(entry.target);
        var el = entry.target, finalText = el.textContent.trim();
        if (!/^[\d,]+$/.test(finalText)) return;
        var target = parseInt(finalText.replace(/,/g, ''), 10);
        var start = null, dur = 750;
        function step(ts) {
          if (!start) start = ts;
          var p = Math.min(1, (ts - start) / dur);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(target * eased).toLocaleString();
          if (p < 1) requestAnimationFrame(step); else el.textContent = finalText;
        }
        requestAnimationFrame(step);
      });
    }, { threshold: 0.4 });
    document.querySelectorAll('.kpi-value').forEach(function (el) { counterObs.observe(el); });
  }
  });

  // ── appendix table filters ─────────────────────────────────────────────
  document.querySelectorAll('.search-box').forEach(function (box) {
    safe(function () {
      var container = box.closest('details');
      if (!container) return;
      var note = container.querySelector('.no-match-note');
      box.addEventListener('input', function () {
        var q = box.value.trim().toLowerCase();
        var anyRow = false, anyVisible = false;
        container.querySelectorAll('table tr').forEach(function (row) {
          if (row.querySelector('th')) return;
          anyRow = true;
          var show = !q || row.textContent.toLowerCase().indexOf(q) !== -1;
          row.style.display = show ? '' : 'none';
          if (show) anyVisible = true;
        });
        if (note) note.style.display = (anyRow && q && !anyVisible) ? 'inline' : 'none';
      });
    });
  });

  // ── chart fullscreen modal ──────────────────────────────────────────────
  safe(function () {
    var modal = document.getElementById('chartModal');
    var modalBody = document.getElementById('modalBody');
    var modalTitle = document.getElementById('modalTitle');
    if (!modal || !modalBody || !modalTitle) return;
    var movedEl = null, movedFromParent = null, movedNextSibling = null;

    function closeModal() {
      if (movedEl) {
        if (movedNextSibling && movedNextSibling.parentNode === movedFromParent) {
          movedFromParent.insertBefore(movedEl, movedNextSibling);
        } else if (movedFromParent) {
          movedFromParent.appendChild(movedEl);
        }
        if (movedEl.classList.contains('echart') && movedEl.__chartInstance) movedEl.__chartInstance.resize();
      }
      movedEl = movedFromParent = movedNextSibling = null;
      modal.hidden = true;
      document.body.style.overflow = '';
    }
    modal.querySelectorAll('[data-close-modal]').forEach(function (el) { el.addEventListener('click', closeModal); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) closeModal(); });

    document.querySelectorAll('.expand-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        try {
          var card = document.getElementById('chart-' + btn.getAttribute('data-expand'));
          if (!card) return;
          modalTitle.textContent = btn.getAttribute('data-title') || 'Chart';
          var holder = card.querySelector('.echart');
          if (holder) {
            movedEl = holder; movedFromParent = holder.parentNode;
            movedNextSibling = holder.nextElementSibling;
            modalBody.innerHTML = '';
            modalBody.appendChild(holder);
            if (holder.__chartInstance) holder.__chartInstance.resize();
          } else {
            var img = card.querySelector('img');
            modalBody.innerHTML = '';
            if (img) {
              var clone = img.cloneNode();
              clone.className = ''; clone.style.cssText = 'max-width:100%;max-height:100%;margin:auto;';
              modalBody.appendChild(clone);
            }
          }
          modal.hidden = false;
          document.body.style.overflow = 'hidden';
        } catch (err) { if (window.console) console.warn('chart expand:', err); }
      });
    });

    safe(function () {
      window.addEventListener('resize', function () { instances.forEach(function (c) { c.resize(); }); });
    });
  });
})();
</script>
{% endif %}

</body>
</html>
