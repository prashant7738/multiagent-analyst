# Backend API Configuration (defaults to 0.0.0.0:8000)
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_LOG_LEVEL=info

# LLM API Keys
GROQ_API_KEY=
GEMINI_API_KEY=

# Database Configuration
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public
POSTGRES_JOBS_TABLE=analysis_jobs
POSTGRES_USERS_TABLE=app_users

HF_TOKEN=

# RAG dataset-chat: max rows embedded per index build (default 20000).
# Lower this on memory-constrained hosts (e.g. Render free tier = 512 MB).
RAG_MAX_ROWS=1000
# Rows per pandas chunk while reading + reservoir-sampling the upload (default 25000).
RAG_READ_CHUNK_ROWS=25000
# Seconds a build may sit in "building" with no progress before it's treated as
# dead and reset so the next chat turn retries it (default 900).
RAG_BUILD_TIMEOUT_SECONDS=900