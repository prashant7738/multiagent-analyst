<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ dataset_name }} — Data Insights Report</title>
<script>(function(){try{var t=localStorage.getItem('ir-theme');if(t!=='dark'&&t!=='light'){t=(window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light';}document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
<script>document.documentElement.classList.add('js');</script>
<style>
  /* ── design tokens ─────────────────────────────────────────────────────────── */
  :root {
    --primary: #4f46e5;
    --primary-light: #eef2ff;
    --primary-dark: #3730a3;
    --accent: #0891b2;
    --success: #059669;
    --warning: #d97706;
    --danger: #dc2626;
    --neutral-50: #f9fafb;
    --neutral-100: #f3f4f6;
    --neutral-200: #e5e7eb;
    --neutral-300: #d1d5db;
    --neutral-400: #9ca3af;
    --neutral-600: #4b5563;
    --neutral-700: #374151;
    --neutral-800: #1f2937;
    --neutral-900: #111827;
    --white: #ffffff;
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }
  [data-theme="dark"] {
    --primary: #818cf8;
    --primary-light: #312e81;
    --primary-dark: #a5b4fc;
    --accent: #06b6d4;
    --neutral-50: #0b1220;
    --neutral-100: #111827;
    --neutral-200: #1f2937;
    --neutral-300: #374151;
    --neutral-400: #6b7280;
    --neutral-600: #9ca3af;
    --neutral-700: #d1d5db;
    --neutral-800: #e5e7eb;
    --neutral-900: #f3f4f6;
    --white: #1f2937;
    --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.6);
  }

  /* ── reset & base ──────────────────────────────────────────────────────────── */
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    background: var(--neutral-50);
    color: var(--neutral-800);
    font-size: 14px;
    line-height: 1.6;
  }
  [data-theme="dark"] body {
    background: var(--neutral-50);
    color: var(--neutral-800);
  }
  
  h1 { font-size: 32px; font-weight: 800; line-height: 1.2; margin-bottom: 12px; }
  h2 { font-size: 24px; font-weight: 700; margin: 32px 0 16px; padding-bottom: 12px; border-bottom: 2px solid var(--neutral-200); }
  h3 { font-size: 16px; font-weight: 600; margin: 20px 0 12px; }
  h4 { font-size: 14px; font-weight: 600; margin: 16px 0 8px; }
  p { margin-bottom: 12px; }
  a { color: var(--primary); text-decoration: none; font-weight: 500; }
  a:hover { opacity: 0.8; }
  ul, ol { margin-left: 20px; margin-bottom: 16px; }
  li { margin-bottom: 8px; }
  table { width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 13px; }
  th, td { border-bottom: 1px solid var(--neutral-200); padding: 12px; text-align: left; }
  th { background: var(--neutral-100); font-weight: 600; }
  tr:hover td { background: var(--neutral-100); }

  /* ── layout ────────────────────────────────────────────────────────────────── */
  .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; }
  .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }

  /* ── navbar ────────────────────────────────────────────────────────────────── */
  .navbar {
    background: var(--white);
    border-bottom: 1px solid var(--neutral-200);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: var(--shadow);
  }
  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
  }
  .navbar-brand {
    font-size: 18px;
    font-weight: 800;
    color: var(--primary);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .navbar-nav {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    flex: 1;
    margin: 0 20px;
  }
  .navbar-nav a {
    font-size: 12px;
    padding: 8px 12px;
    border-radius: 6px;
    color: var(--neutral-600);
    white-space: nowrap;
    transition: all 0.2s;
  }
  .navbar-nav a:hover {
    background: var(--neutral-100);
    color: var(--primary);
  }
  .navbar-nav a.active {
    background: var(--primary-light);
    color: var(--primary);
  }
  .navbar-actions {
    display: flex;
    gap: 8px;
  }
  .btn-icon {
    width: 40px;
    height: 40px;
    border: 1px solid var(--neutral-200);
    background: var(--white);
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    transition: all 0.2s;
  }
  .btn-icon:hover {
    background: var(--neutral-100);
    box-shadow: var(--shadow);
  }

  /* ── hero / cover ──────────────────────────────────────────────────────────── */
  .hero {
    background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
    color: white;
    padding: 60px 0;
    margin-bottom: 40px;
  }
  .hero-content h1 {
    color: white;
    margin-bottom: 8px;
  }
  .hero-meta {
    display: flex;
    gap: 20px;
    margin-top: 20px;
    flex-wrap: wrap;
  }
  .hero-meta-item {
    display: flex;
    flex-direction: column;
  }
  .hero-meta-label {
    font-size: 12px;
    opacity: 0.9;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .hero-meta-value {
    font-size: 20px;
    font-weight: 700;
    margin-top: 4px;
  }
  .hero-badges {
    display: flex;
    gap: 10px;
    margin-top: 16px;
    flex-wrap: wrap;
  }
  .badge {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }
  .badge.success { background: var(--success); border: none; }
  .badge.warning { background: var(--warning); border: none; }
  .badge.danger { background: var(--danger); border: none; }

  /* ── cards ─────────────────────────────────────────────────────────────────── */
  .card {
    background: var(--white);
    border: 1px solid var(--neutral-200);
    border-radius: 8px;
    padding: 20px;
    box-shadow: var(--shadow);
    transition: all 0.3s;
  }
  .card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--primary-light);
  }
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .card-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--primary);
  }
  .card-subtitle {
    font-size: 12px;
    color: var(--neutral-600);
    margin-top: 4px;
  }

  /* ── KPI metrics ───────────────────────────────────────────────────────────── */
  .kpi {
    background: var(--white);
    border: 1px solid var(--neutral-200);
    border-radius: 8px;
    padding: 16px;
    position: relative;
    overflow: hidden;
  }
  .kpi::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--primary), transparent);
  }
  .kpi-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--neutral-600);
    font-weight: 600;
  }
  .kpi-value {
    font-size: 28px;
    font-weight: 800;
    margin: 8px 0;
    color: var(--neutral-900);
  }
  .kpi-hint {
    font-size: 11px;
    color: var(--neutral-600);
  }

  /* ── health indicator ──────────────────────────────────────────────────────── */
  .health-bar {
    width: 100%;
    height: 8px;
    background: var(--neutral-200);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 8px;
  }
  .health-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--success), var(--primary));
    border-radius: 999px;
    transition: width 0.6s ease;
  }
  .health-fill.warning { background: linear-gradient(90deg, var(--warning), #f59e0b); }
  .health-fill.danger { background: linear-gradient(90deg, var(--danger), #f87171); }
  .health-label {
    font-size: 12px;
    color: var(--neutral-600);
  }

  /* ── insight boxes ─────────────────────────────────────────────────────────── */
  .insight-box {
    background: linear-gradient(135deg, var(--primary-light), var(--white));
    border: 1px solid var(--primary);
    border-radius: 8px;
    padding: 20px;
    margin: 20px 0;
  }
  .insight-box h3 {
    color: var(--primary);
    margin-top: 0;
  }
  .insight-highlight {
    background: var(--primary-light);
    border-left: 3px solid var(--primary);
    padding: 12px 16px;
    border-radius: 4px;
    margin: 12px 0;
  }

  /* ── sections ──────────────────────────────────────────────────────────────── */
  .section {
    margin-bottom: 40px;
  }
  .section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .section-header::before {
    content: '';
    width: 4px;
    height: 24px;
    background: var(--primary);
    border-radius: 999px;
  }
  .section-subtitle {
    color: var(--neutral-600);
    font-size: 14px;
    margin-top: 4px;
  }

  /* ── finding cards ─────────────────────────────────────────────────────────── */
  .finding-card {
    background: var(--white);
    border: 1px solid var(--neutral-200);
    border-radius: 8px;
    padding: 16px;
    display: flex;
    gap: 12px;
  }
  .finding-card::before {
    content: '●';
    color: var(--primary);
    font-size: 20px;
    flex: 0 0 20px;
  }
  .finding-text h4 {
    margin-top: 0;
  }

  /* ── chart container ───────────────────────────────────────────────────────── */
  .chart-container {
    background: var(--white);
    border: 1px solid var(--neutral-200);
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: var(--shadow);
  }
  .chart-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--neutral-900);
    margin-bottom: 8px;
  }
  .chart-subtitle {
    font-size: 12px;
    color: var(--neutral-600);
    margin-bottom: 12px;
  }
  .chart-description {
    font-size: 13px;
    color: var(--neutral-700);
    line-height: 1.5;
    margin-bottom: 12px;
  }
  .chart-meta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .chart-tag {
    background: var(--primary-light);
    color: var(--primary);
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
  }
  .echart {
    width: 100%;
    height: 350px;
    margin: 12px 0;
  }
  .chart-static {
    display: none;
    width: 100%;
    max-width: 700px;
    height: auto;
    margin: 12px auto;
    border-radius: 6px;
  }

  /* ── recommendations ───────────────────────────────────────────────────────── */
  .recommendation-item {
    background: var(--neutral-50);
    border: 1px solid var(--neutral-200);
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 12px;
  }
  .recommendation-item h4 {
    color: var(--primary);
    margin-top: 0;
  }
  .priority-badge {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .priority-high { background: var(--success); color: white; }
  .priority-medium { background: var(--warning); color: white; }
  .priority-low { background: var(--neutral-400); color: white; }

  /* ── footer & appendix ─────────────────────────────────────────────────────── */
  .footer {
    border-top: 2px solid var(--neutral-200);
    padding-top: 20px;
    margin-top: 40px;
    color: var(--neutral-600);
    font-size: 12px;
  }
  .tech-details {
    background: var(--neutral-100);
    border: 1px solid var(--neutral-200);
    border-radius: 8px;
    padding: 16px;
    margin-top: 20px;
  }
  .tech-details summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--neutral-800);
    user-select: none;
  }
  .tech-details summary:hover {
    color: var(--primary);
  }
  .tech-details[open] summary {
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--neutral-200);
  }

  /* ── modal ─────────────────────────────────────────────────────────────────── */
  .modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }
  .modal[hidden] { display: none; }
  .modal-content {
    background: var(--white);
    border-radius: 12px;
    max-width: 90vw;
    max-height: 90vh;
    overflow: auto;
    box-shadow: var(--shadow-lg);
  }
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--neutral-200);
  }
  .modal-body {
    padding: 20px;
  }

  /* ── animations ────────────────────────────────────────────────────────────── */
  [data-reveal] {
    animation: slideUp 0.6s ease-out forwards;
  }
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── print styles ──────────────────────────────────────────────────────────── */
  @media print {
    .navbar, .navbar-actions, .btn-icon { display: none !important; }
    .hero { page-break-after: always; }
    .chart-container, .section, .card { page-break-inside: avoid; }
    .echart { display: none !important; }
    .chart-static { display: block !important; }
    body { font-size: 11px; }
  }

  /* ── responsive ────────────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    h1 { font-size: 24px; }
    h2 { font-size: 20px; }
    .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
    .navbar-nav { display: none; }
    .hero { padding: 40px 0; }
    .kpi-value { font-size: 24px; }
  }

  /* ── utilities ─────────────────────────────────────────────────────────────── */
  .text-center { text-align: center; }
  .text-muted { color: var(--neutral-600); }
  .mt-0 { margin-top: 0; }
  .mt-20 { margin-top: 20px; }
  .mb-20 { margin-bottom: 20px; }
  .gap-2 { gap: 16px; }
</style>
</head>
<body>

<!-- Navigation -->
<nav class="navbar">
  <div class="container navbar-inner">
    <div class="navbar-brand">
      📊 DataInsights
    </div>
    <div class="navbar-nav">
      <a href="#overview" data-section="overview">Overview</a>
      <a href="#key-findings" data-section="key-findings">Key Findings</a>
      <a href="#analysis" data-section="analysis">Analysis</a>
      <a href="#recommendations" data-section="recommendations">Recommendations</a>
      <a href="#details" data-section="details">Details</a>
    </div>
    <div class="navbar-actions">
      <button id="themeToggle" class="btn-icon" type="button" title="Toggle dark mode">🌓</button>
      <button class="btn-icon" type="button" onclick="window.print()" title="Print / Save as PDF">🖨️</button>
    </div>
  </div>
</nav>

<!-- Hero Section -->
<section class="hero">
  <div class="container hero-content">
    <h1>{{ dataset_name }}</h1>
    <p style="font-size: 16px; opacity: 0.95; margin: 4px 0 0;">Automated Data Analysis Report</p>
    <div class="hero-meta">
      <div class="hero-meta-item">
        <span class="hero-meta-label">Dataset Size</span>
        <span class="hero-meta-value">{{ facts.dataset_shape[0] if facts.dataset_shape else 'N/A' }} rows</span>
      </div>
      <div class="hero-meta-item">
        <span class="hero-meta-label">Columns</span>
        <span class="hero-meta-value">{{ facts.dataset_shape[1] if facts.dataset_shape else 'N/A' }}</span>
      </div>
      <div class="hero-meta-item">
        <span class="hero-meta-label">Generated</span>
        <span class="hero-meta-value">{{ generated_at }}</span>
      </div>
    </div>
    <div class="hero-badges">
      {% set quality = facts.data_quality.overall_quality_score %}
      {% if quality is not none %}
        {% if quality >= 80 %}
          <span class="badge success">✓ Quality {{ quality|round(0)|int }}/100</span>
        {% elif quality >= 50 %}
          <span class="badge warning">⚠ Quality {{ quality|round(0)|int }}/100</span>
        {% else %}
          <span class="badge danger">✗ Quality {{ quality|round(0)|int }}/100</span>
        {% endif %}
      {% endif %}
      {% if facts.validation.passed %}
        <span class="badge success">✓ Validation Passed</span>
      {% else %}
        <span class="badge danger">✗ Validation Issues</span>
      {% endif %}
    </div>
  </div>
</section>

<!-- Main Content -->
<main class="container">

  <!-- Quick Stats -->
  <section class="section" id="overview" data-reveal>
    <div class="section-header">
      <h2>Quick Overview</h2>
    </div>
    <div class="grid-4">
      {% for card in kpis %}
      <div class="kpi">
        <div class="kpi-label">{{ card.label }}</div>
        <div class="kpi-value">{{ card.value }}</div>
        {% if card.hint %}<div class="kpi-hint">{{ card.hint }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- Data Health -->
  {% set quality = facts.data_quality.overall_quality_score %}
  {% if quality is not none %}
  <section class="section" data-reveal>
    <div class="card">
      <div class="card-header">
        <div class="card-title">Data Quality Score</div>
      </div>
      <div class="health-bar">
        <div class="health-fill {{ 'warning' if quality < 70 else '' }}{{ ' danger' if quality < 50 else '' }}" 
             style="width: {{ [quality, 100]|min }}%;"></div>
      </div>
      <div class="health-label">
        <strong>{{ quality|round(0)|int }}/100</strong> — 
        {% if quality >= 80 %}
          Excellent data quality. Your dataset is clean and reliable.
        {% elif quality >= 60 %}
          Good quality. Minor issues detected but overall usable.
        {% else %}
          Issues detected. Review the appendix for details.
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  <!-- Plain Language Summary -->
  {% if narrative.plain_language_insights or narrative.bottom_line %}
  <section class="section" id="key-findings" data-reveal>
    <div class="section-header">
      <h2>What This Data Tells You</h2>
    </div>
    <div class="section-subtitle">No statistics background required — just the facts.</div>
    {% if narrative.bottom_line %}
    <div class="insight-highlight">
      <strong>{{ narrative.bottom_line }}</strong>
    </div>
    {% endif %}
    {% if narrative.plain_language_insights %}
    <div style="display: grid; gap: 12px; margin-top: 16px;">
      {% for insight in narrative.plain_language_insights %}
      <div class="finding-card">
        <div class="finding-text">
          <p>{{ insight }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </section>
  {% endif %}

  <!-- Key Findings -->
  {% if narrative.executive_summary or narrative.key_findings %}
  <section class="section" id="analysis" data-reveal>
    <div class="section-header">
      <h2>Key Findings</h2>
    </div>
    <div class="section-subtitle">{{ narrative.executive_summary }}</div>
    
    {% if narrative.key_findings %}
    <div class="grid-2 mt-20">
      {% for finding in narrative.key_findings %}
      <div class="finding-card">
        <div class="finding-text">
          <h4>Finding {{ loop.index }}</h4>
          <p>{{ finding }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </section>
  {% endif %}

  <!-- Charts & Visualizations -->
  {% for key, sec in chart_sections %}
  <section class="section" id="analysis" data-reveal>
    <div class="section-header">
      <h2>{{ sec.heading }}</h2>
    </div>
    {% if sec.blurb %}<div class="section-subtitle">{{ sec.blurb }}</div>{% endif %}
    
    {% for c in sec.charts %}
    <div class="chart-container" data-reveal>
      <div class="chart-title">{{ c.title }}</div>
      {% if c.subtitle %}<div class="chart-subtitle">{{ c.subtitle }}</div>{% endif %}
      {% if c.plain_summary or c.why_it_matters %}
      <div class="chart-description">{{ c.plain_summary or c.why_it_matters }}</div>
      {% endif %}
      
      {% if c.annotations %}
      <div class="chart-meta">
        {% for a in c.annotations %}
        {% if a.label %}
        <span class="chart-tag">{{ a.label }}
          {% if a.value is defined and a.value is not none and a.value != '' %}
            : <strong>{{ a.value }}</strong>
          {% endif %}
        </span>
        {% endif %}
        {% endfor %}
      </div>
      {% endif %}

      {% if c.render == 'echarts' and c.option_json and has_interactive and c.img_b64 %}
      <div class="echart" id="ec-{{ c.id }}" data-option="{{ c.option_json }}"></div>
      <img class="chart-static" src="{{ c.img_b64 }}" alt="{{ c.alt_text }}">
      {% elif c.img_b64 %}
      <img src="{{ c.img_b64 }}" alt="{{ c.alt_text }}" style="width: 100%; max-width: 700px; display: block; margin: 12px auto; border-radius: 6px;">
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endfor %}

  <!-- Recommendations -->
  {% if narrative.recommendations or narrative.risks_and_caveats %}
  <section class="section" id="recommendations" data-reveal>
    <div class="section-header">
      <h2>Recommendations & Next Steps</h2>
    </div>
    <div class="section-subtitle">Actionable insights based on your data</div>
    
    <div class="grid-2 mt-20">
      {% if narrative.recommendations %}
      <div>
        <h3>Recommended Actions</h3>
        {% for rec in narrative.recommendations %}
        <div class="recommendation-item">
          <p>{{ rec }}</p>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      
      {% if narrative.risks_and_caveats %}
      <div>
        <h3>Important Considerations</h3>
        {% for risk in narrative.risks_and_caveats %}
        <div class="recommendation-item" style="background: #fef3c7;">
          <p style="margin: 0;">⚠️ {{ risk }}</p>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  <!-- Technical Details -->
  <section class="section" id="details" data-reveal>
    <div class="section-header">
      <h2>Technical Details</h2>
    </div>
    <div class="section-subtitle">For those who want to dig deeper</div>

    {% if facts.data_quality_detail %}
    <details class="tech-details">
      <summary>📋 Data Quality Report</summary>
      <div style="margin-top: 12px;">
        {% set dqd = facts.data_quality_detail %}
        <h4>Duplicates: {{ dqd.duplicates.action }}</h4>
        <p>{{ dqd.duplicates.exact_duplicates_detected }} exact duplicates found and {{ dqd.duplicates.action }}.</p>
        
        {% if dqd.has_missing %}
        <h4>Missing Values</h4>
        <table>
          <tr><th>Column</th><th>Missing Count</th><th>Missing %</th><th>Action Taken</th></tr>
          {% for row in dqd.missing_values %}
          <tr>
            <td>{{ row.column }}</td>
            <td>{{ row.missing_count }}</td>
            <td>{{ row.missing_pct }}%</td>
            <td>{{ row.action }}</td>
          </tr>
          {% endfor %}
        </table>
        {% else %}
        <p>No missing values detected.</p>
        {% endif %}
      </div>
    </details>
    {% endif %}

    {% if facts.top_correlations %}
    <details class="tech-details">
      <summary>🔗 Column Relationships (Correlations)</summary>
      <table style="margin-top: 12px;">
        <tr><th>Column 1</th><th>Column 2</th><th>Correlation</th><th>Strength</th></tr>
        {% for pair in facts.top_correlations[:10] %}
        <tr>
          <td>{{ pair.col1 }}</td>
          <td>{{ pair.col2 }}</td>
          <td>{{ pair.pearson_r }}</td>
          <td>{{ pair.strength }}</td>
        </tr>
        {% endfor %}
      </table>
    </details>
    {% endif %}

    {% if facts.significant_trends %}
    <details class="tech-details">
      <summary>📈 Trends Over Time</summary>
      <table style="margin-top: 12px;">
        <tr><th>Column</th><th>Trend Direction</th><th>Strength (R²)</th></tr>
        {% for trend in facts.significant_trends[:10] %}
        <tr>
          <td>{{ trend.column }}</td>
          <td>{{ trend.trend }}</td>
          <td>{{ trend.r_squared }}</td>
        </tr>
        {% endfor %}
      </table>
    </details>
    {% endif %}

    {% if glossary %}
    <details class="tech-details">
      <summary>📚 Glossary of Terms</summary>
      <div style="columns: 2; gap: 20px; margin-top: 12px;">
        {% for term, definition in glossary.items() %}
        <div style="break-inside: avoid; margin-bottom: 12px;">
          <strong>{{ term }}</strong><br>
          <span style="color: var(--neutral-600); font-size: 13px;">{{ definition }}</span>
        </div>
        {% endfor %}
      </div>
    </details>
    {% endif %}
  </section>

  <!-- Footer -->
  <footer class="footer" data-reveal>
    <p><strong>About This Report</strong></p>
    <p>
      This report was generated automatically using advanced data analysis. All figures are computed from your dataset
      and cross-checked for accuracy. The analysis includes data quality assessment, statistical testing, trend detection,
      and natural language interpretation to make insights actionable and understandable.
    </p>
    <p style="margin-top: 16px; font-size: 11px;">
      Generated on {{ generated_at }} | Data insights powered by automated analysis pipeline
    </p>
  </footer>

</main>

<!-- Scripts -->
<script>
// Theme toggle
document.getElementById('themeToggle')?.addEventListener('click', () => {
  const html = document.documentElement;
  const theme = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  html.setAttribute('data-theme', theme);
  localStorage.setItem('ir-theme', theme);
});

// Smooth scroll navigation
document.querySelectorAll('a[data-section]').forEach(link => {
  link.addEventListener('click', (e) => {
    const target = document.getElementById(link.dataset.section);
    if (target) {
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth' });
      link.classList.add('active');
      document.querySelectorAll('a[data-section]').forEach(l => l.classList.remove('active'));
      link.classList.add('active');
    }
  });
});

// Chart expansion modal (if needed)
document.querySelectorAll('[data-expand]').forEach(btn => {
  btn.addEventListener('click', () => {
    const chartId = btn.dataset.expand;
    const chart = document.getElementById(`ec-${chartId}`);
    if (chart) {
      // Expand chart in modal
      console.log('Expand chart:', chartId);
    }
  });
});

// ECharts initialization (if library is loaded)
if (typeof echarts !== 'undefined') {
  document.querySelectorAll('[data-option]').forEach(container => {
    try {
      const option = JSON.parse(container.dataset.option);
      const chart = echarts.init(container);
      chart.setOption(option);
      window.addEventListener('resize', () => chart.resize());
    } catch (e) {
      console.warn('Failed to initialize chart:', e);
    }
  });
}
</script>

</body>
</html>
